{
  "name": "sophis-social",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:emulator": "firebase emulators:exec --project demo-sophis --config ../firebase.json --only auth,firestore,storage 'npm test'",
    "check": "node --check src/index.js && node --check src/social_service.js && node --check src/photo_service.js && node --check src/cleanup_service.js"
  },
  "dependencies": {
    "firebase-admin": "^13.5.0",
    "firebase-functions": "^6.6.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.4.0",
    "firebase-tools": "^14.18.0"
  }
}
