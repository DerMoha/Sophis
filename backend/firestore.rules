rules_version = '2';

// Partner sharing: one partner per account. Each person writes one document per
// diary day; the partner reads it. Nothing else is stored.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function name(v) { return v is string && v.size() > 0 && v.size() <= 40; }
    function profilePath(id) { return /databases/$(database)/documents/partnerProfiles/$(id); }
    function connectionPath(id) { return /databases/$(database)/documents/partnerConnections/$(id); }
    function invitePath(code) { return /databases/$(database)/documents/partnerInvites/$(code); }

    // A profile joins a connection that is created in the same batch by one of
    // its two participants, and only while it has no partner yet.
    function linking(id) {
      let next = request.resource.data.connectionId;
      return resource.data.connectionId == null && next is string
        && !exists(connectionPath(next)) && existsAfter(connectionPath(next))
        && getAfter(connectionPath(next)).data.participants.hasAll([id, me()]);
    }
    // A profile leaves a connection that is deleted in the same batch, or that
    // is already gone.
    function unlinking(id) {
      let old = resource.data.connectionId;
      return old is string && request.resource.data.connectionId == null
        && !existsAfter(connectionPath(old))
        && (exists(connectionPath(old))
          ? get(connectionPath(old)).data.participants.hasAll([id, me()])
          : id == me());
    }

    match /partnerProfiles/{id} {
      allow get: if signedIn() && me() == id;
      allow create: if signedIn() && me() == id
        && request.resource.data.keys().hasOnly(['displayName', 'connectionId'])
        && name(request.resource.data.displayName)
        && request.resource.data.connectionId == null;
      allow update: if signedIn() && (
        (me() == id
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && name(request.resource.data.displayName))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connectionId'])
          && (linking(id) || unlinking(id))));
      allow delete: if signedIn() && me() == id && resource.data.connectionId == null;
    }

    // The code is the capability: anyone signed in who knows it may read it.
    match /partnerInvites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.inviterId == me();
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{8}$')
        && request.resource.data.keys().hasOnly(['inviterId', 'displayName', 'expiresAt'])
        && request.resource.data.inviterId == me()
        && request.resource.data.displayName == get(profilePath(me())).data.displayName
        && get(profilePath(me())).data.connectionId == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(2, 'd');
      allow delete: if signedIn() && (resource.data.inviterId == me() || accepted(code));
      function accepted(code) {
        let joined = getAfter(profilePath(me())).data.connectionId;
        return joined is string && getAfter(connectionPath(joined)).data.invite == code;
      }
    }

    match /partnerConnections/{cid} {
      function member() { return signedIn() && me() in get(connectionPath(cid)).data.participants; }

      allow get: if signedIn() && me() in resource.data.participants;
      allow delete: if signedIn() && me() in resource.data.participants;
      // Accepting consumes the invite and links both profiles atomically.
      allow create: if signedIn() && accepting(request.resource.data);
      function accepting(d) {
        let invite = get(invitePath(d.invite)).data;
        return d.keys().hasOnly(['participants', 'names', 'invite', 'createdAt'])
          && d.invite is string && exists(invitePath(d.invite))
          && !existsAfter(invitePath(d.invite))
          && invite.expiresAt > request.time && invite.inviterId != me()
          && d.participants == [invite.inviterId, me()]
          && d.names.keys().hasOnly(d.participants)
          && d.names[invite.inviterId] == invite.displayName
          && d.names[me()] == get(profilePath(me())).data.displayName
          && d.createdAt == request.time
          && getAfter(profilePath(invite.inviterId)).data.connectionId == cid
          && getAfter(profilePath(me())).data.connectionId == cid;
      }

      match /days/{day} {
        allow get, list, delete: if member();
        allow create, update: if member()
          && day == me() + '_' + request.resource.data.date
          && request.resource.data.keys().hasOnly(['date', 'goals', 'burned', 'entries', 'updatedAt'])
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (request.resource.data.goals == null || request.resource.data.goals is map)
          && request.resource.data.burned is number
          && request.resource.data.entries is list
          && request.resource.data.entries.size() <= 300
          && request.resource.data.updatedAt == request.time;
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
